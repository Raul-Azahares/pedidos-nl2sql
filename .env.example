# Copia este fichero a .env y rellena la clave (.env está en .gitignore).
# Clave gratuita de Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de Gemini que traduce las preguntas a SQL (configurable)
LLM_MODEL=gemini-3.5-flash-lite

# Base de datos SQLite generada por el ETL
DB_PATH=data/pedidos.db
