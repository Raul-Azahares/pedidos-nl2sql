# Copy this file to .env and fill in the key (.env is in .gitignore).
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model that translates the questions into SQL (configurable)
LLM_MODEL=gemini-3.5-flash-lite
# Seconds to wait for the LLM before giving up
LLM_TIMEOUT_S=20

# SQLite database created by the ETL
DB_PATH=data/pedidos.db

# Limits for every query generated by the LLM
MAX_ROWS=500
QUERY_TIMEOUT_S=5
